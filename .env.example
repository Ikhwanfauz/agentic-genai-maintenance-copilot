APP_NAME="Agentic GenAI Maintenance Copilot"
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000
MAINTENANCE_API_BASE_URL=http://127.0.0.1:8000
MAINTENANCE_API_TIMEOUT_SECONDS=120

# Local demo password: replace both matching values before starting PostgreSQL.
# Use letters and numbers with the current Compose connection URL.
POSTGRES_PASSWORD=ChangeThisLocalDemoPassword123
DATABASE_URL=postgresql+psycopg://maintenance:ChangeThisLocalDemoPassword123@127.0.0.1:5432/maintenance_copilot

# LangGraph checkpoints remain in SQLite.
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite

ENGINEERING_DOCS_PATH=./data/engineering_docs
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENGINEERING_DOCS_COLLECTION=engineering_docs

LLM_PROVIDER=azure_openai
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

OPENAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini