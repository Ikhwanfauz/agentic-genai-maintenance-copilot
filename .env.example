APP_NAME="Agentic GenAI Maintenance Copilot"
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/maintenance_copilot.db
ENGINEERING_DOCS_PATH=./data/engineering_docs
VECTOR_STORE_PATH=./data/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENGINEERING_DOCS_COLLECTION=engineering_docs
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

OPENAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=